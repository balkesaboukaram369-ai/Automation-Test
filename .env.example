# Kopiere diese Datei nach ".env" und trage die Werte ein.
# Die Datei ".env" wird von Git ignoriert und nie eingecheckt.

# Gemeinsames Passwort der Demo-Benutzer.
# Es wird öffentlich auf der Login-Seite von https://www.saucedemo.com/ angezeigt
# (Abschnitt "Password for all users").
SAUCE_PASSWORD=

# Optional:
# BASE_URL=https://www.saucedemo.com/
# LOGIN_TIME_LIMIT_SECONDS=3
